<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_margin="6dp"
    android:padding="16dp"
    android:elevation="2dp">

    <!-- Header: ID + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvAdminResId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Booking #42"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111827"/>

        <TextView
            android:id="@+id/tvAdminResStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONFIRMED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#166534"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/status_badge_bg"/>
    </LinearLayout>

    <!-- Workspace Info -->
    <TextView
        android:id="@+id/tvAdminResSpace"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The Creative Hub · Cebu City"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1E3A8A"
        android:layout_marginBottom="6dp"/>

    <!-- User Info -->
    <TextView
        android:id="@+id/tvAdminResUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="John Doe · johndoe@email.com"
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="6dp"/>

    <!-- Time -->
    <TextView
        android:id="@+id/tvAdminResTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="May 15 · 9:00 AM – 11:00 AM"
        android:textSize="13sp"
        android:textColor="#374151"
        android:layout_marginBottom="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        android:layout_marginBottom="10dp"/>

    <!-- Footer: Amount + Cancel Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAdminResAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total: ₱589.00"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#111827"/>

        <Button
            android:id="@+id/btnCancelReservation"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Cancel"
            android:textSize="12sp"
            android:backgroundTint="#FEF2F2"
            android:textColor="#DC2626"/>
    </LinearLayout>

</LinearLayout>
