<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_margin="8dp"
    android:padding="16dp"
    android:elevation="2dp">

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvReservationStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UPCOMING"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#2563EB"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:background="@drawable/status_badge_bg"
        android:layout_marginBottom="10dp"/>

    <!-- Space Name -->
    <TextView
        android:id="@+id/tvReservationSpaceId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The Creative Hub"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginBottom="6dp"/>

    <!-- Time -->
    <TextView
        android:id="@+id/tvReservationTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="May 15 · 9:00 AM – 11:00 AM"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        android:layout_marginBottom="10dp"/>

    <!-- Amount -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total"
            android:textSize="14sp"
            android:textColor="#6B7280" />

        <TextView
            android:id="@+id/tvReservationAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$40.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#111827" />

    </LinearLayout>

    <Button
        android:id="@+id/btnCancelReservation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:text="Cancel Reservation"
        android:textColor="#DC2626"
        android:background="?attr/selectableItemBackground"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
