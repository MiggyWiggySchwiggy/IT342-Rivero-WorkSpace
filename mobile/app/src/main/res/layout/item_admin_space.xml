<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_margin="6dp"
    android:padding="16dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdminSpaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Space Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:id="@+id/tvAdminSpaceLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdminSpaceAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#166534"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/status_badge_bg"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvAdminSpaceType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meeting Room · 6 people"
            android:textSize="13sp"
            android:textColor="#374151"/>

        <TextView
            android:id="@+id/tvAdminSpaceRate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱500/hr"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#2563EB"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F3F4F6"
        android:layout_marginBottom="10dp"/>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnEditSpace"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Edit"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#F3F4F6"
            android:textColor="#374151"/>

        <Button
            android:id="@+id/btnUploadImages"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Images"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#EFF6FF"
            android:textColor="#2563EB"/>

        <Button
            android:id="@+id/btnDeleteSpace"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Delete"
            android:textSize="13sp"
            android:backgroundTint="#FEF2F2"
            android:textColor="#DC2626"/>
    </LinearLayout>

</LinearLayout>
