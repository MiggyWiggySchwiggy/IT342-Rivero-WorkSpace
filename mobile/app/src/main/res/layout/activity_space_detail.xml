<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Hero: Image Gallery + Back button overlay -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vpImageGallery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Back button overlaid on gallery -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="12dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="#CC000000"
                android:padding="8dp"
                android:tint="#FFFFFF"
                android:contentDescription="Back"/>
        </FrameLayout>

        <!-- Content Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Space Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:id="@+id/tvDetailType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Type · Location"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvDetailPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₱0 / hr"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#2563EB"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Description -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ABOUT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- Amenities & Policies -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMENITIES &amp; UTILITIES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetailAmenities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingMultiplier="1.5"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="POLICIES"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDetailPolicies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#374151"
                android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- ── Availability Grid ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AVAILABILITY (NEXT 7 DAYS)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:letterSpacing="0.1"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap a green slot to pre-fill your booking time."
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="12dp"/>

            <!-- Horizontal scrollable day columns -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/llAvailabilityGrid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top"/>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Book Button -->
        <Button
            android:id="@+id/btnBookSpace"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Book This Space"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"/>

    </LinearLayout>
</ScrollView>
