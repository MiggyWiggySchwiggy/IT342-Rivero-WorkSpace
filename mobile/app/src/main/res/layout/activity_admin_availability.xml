<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F5F9">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#7C3AED"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnBackAvailability"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:layout_marginEnd="8dp"
            android:tint="#FFFFFF"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manage Availability"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tvAvailabilitySpaceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workspace Name"
                android:textSize="13sp"
                android:textColor="#DDD6FE" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAvailabilitySlots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false"/>

        <ProgressBar
            android:id="@+id/progressBarAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvEmptyAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="No operating hours defined.\nClick Add Slot or Generate Defaults below."
            android:textSize="15sp"
            android:textColor="#64748B"
            android:textAlignment="center"
            android:visibility="gone"/>
    </FrameLayout>

    <!-- Bottom Actions Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:weightSum="3">

        <Button
            android:id="@+id/btnGenerateDefaults"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Defaults"
            android:textSize="12sp"
            android:backgroundTint="#F3F4F6"
            android:textColor="#374151"
            android:layout_marginEnd="6dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <Button
            android:id="@+id/btnAddSlot"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="+ Add"
            android:textSize="12sp"
            android:backgroundTint="#EDE9FE"
            android:textColor="#7C3AED"
            android:layout_marginEnd="6dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <Button
            android:id="@+id/btnSaveAvailability"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Save"
            android:textSize="12sp"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF"
            style="@style/Widget.MaterialComponents.Button"/>
    </LinearLayout>
</LinearLayout>
